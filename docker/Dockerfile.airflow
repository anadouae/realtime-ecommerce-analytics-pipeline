# Lightweight Astronomer-style image: Airflow + pipeline package on PYTHONPATH.
FROM apache/airflow:2.9.3-python3.12

USER root
RUN mkdir -p /opt/pipeline && chown -R airflow:root /opt/pipeline
USER airflow

ENV PIPELINE_HOME=/opt/pipeline
ENV PYTHONPATH=/opt/pipeline/src

COPY --chown=airflow:root requirements.txt /opt/pipeline/requirements.txt
RUN pip install --no-cache-dir -r /opt/pipeline/requirements.txt

COPY --chown=airflow:root src /opt/pipeline/src
COPY --chown=airflow:root dags /opt/airflow/dags
COPY --chown=airflow:root sql /opt/pipeline/sql
COPY --chown=airflow:root config /opt/pipeline/config
