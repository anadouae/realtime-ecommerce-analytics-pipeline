# Copy to `.env` and fill in. Never commit real credentials.
# Scripts auto-source `.env` when present (`set -a; source .env`).

# --- Local warehouse (first-class path) ---
SINK_BACKEND=duckdb
DUCKDB_PATH=data/warehouse/analytics.duckdb
CLICKSTREAM_PATH=data/raw/clickstream.ndjson
CLICKSTREAM_TOPIC=clickstream.events

# --- Kafka / Redpanda (local compose uses PLAINTEXT on localhost:19092) ---
KAFKA_BOOTSTRAP=localhost:19092
# Optional SASL for secured brokers (leave unset for local Redpanda):
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# --- Postgres (optional alt sink / compose service) ---
POSTGRES_USER=ecom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecom_analytics
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Snowflake (optional cloud sink — never hardcode in source) ---
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=ANALYTICS_WH
# SNOWFLAKE_DATABASE=ECOM_ANALYTICS
# SNOWFLAKE_SCHEMA=MART
# SNOWFLAKE_ROLE=TRANSFORMER

# --- Spark / Airflow ---
SPARK_MASTER=local[*]
PIPELINE_HOME=.
LAND_EVENT_COUNT=150
LAND_EVENT_RATE=200
LAND_SEED=42
